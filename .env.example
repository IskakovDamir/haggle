# Statement reading and negotiation. Set one of the two keys; Claude is used when both are set,
# unless AI_PROVIDER says otherwise. Without either, those features show "not configured".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=

# Voice calls in the browser (ElevenLabs Agents). Run `pnpm setup:agent` once to get the agent id.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional, read only by `pnpm setup:agent`.
ELEVENLABS_AGENT_LLM=
ELEVENLABS_VOICE_ID=

# Phone calls: the agent rings a real phone through a Twilio number connected to ElevenLabs.
# 1. Twilio console: buy a number (trial accounts can only ring numbers verified in Twilio).
# 2. Fill the three TWILIO_ lines, run `pnpm setup:phone`, paste the id it prints below.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ELEVENLABS_PHONE_NUMBER_ID=
# The owner's approved phones, separated by commas.
PHONE_ALLOWED_NUMBERS=
# Optional: country codes in which visitors may ring their own phones, e.g. "+1,+7". Each such number
# rings at most 3 times an hour, and the server places at most PHONE_DAILY_CAP of these calls a day.
# Premium-rate lines (+1 900, +1 976) are never rung. Leave empty to ring approved phones only.
PHONE_OPEN_PREFIXES=
PHONE_DAILY_CAP=60

# Pay after a win. Test-mode key only (sk_test_...); live keys are refused.
STRIPE_SECRET_KEY=

# Public origin, used for checkout return links. Defaults to the request origin.
NEXT_PUBLIC_SITE_URL=

# Signs share links for win cards (any long random string, e.g. `openssl rand -hex 32`).
# Optional: without it share links still work, but every card says "Unverified".
SHARE_SECRET=
